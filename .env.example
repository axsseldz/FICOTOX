# Configuracion de FICOTOX (Next.js). Copia este archivo como .env

# Secretos
# SECRET_KEY sella la bitacora de auditoria. Definela UNA vez (32+ caracteres
# aleatorios, p. ej. `openssl rand -hex 32`) y no la cambies: cambiarla rompe la
# verificacion de lo ya sellado (ver CLAUDE.md, "Arquitectura").
# Si queda vacia, la llave es instance/auditoria.key (respaldala con la base).
SECRET_KEY=
# JWT_SECRET firma las sesiones. En produccion es obligatoria, de 32+ caracteres
# y distinta de los valores de ejemplo: si no, el servidor no arranca.
JWT_SECRET=
# Duracion maxima de una sesion (horas). Por omision 8.
JWT_EXPIRES_HOURS=8

# Sesiones y bloqueo de cuentas (Fase 2)
# Cierre por inactividad (minutos); se avisa 1 minuto antes.
SESION_INACTIVIDAD_MIN=30
# Intentos fallidos (inicio de sesion o reautenticacion) que bloquean una cuenta,
# ventana en que se cuentan y duracion del bloqueo (minutos).
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
LOGIN_BLOQUEO_MIN=15
# Fallos desde una misma IP (en la misma ventana) que bloquean esa IP.
LOGIN_IP_MAX_INTENTOS=20
# Vigencia del token de reautenticacion para acciones criticas (minutos).
REAUTH_TTL_MIN=5
# true solo si el servidor esta detras de un proxy propio que fija X-Forwarded-For.
TRUST_PROXY=false
# Dias que una solicitud de autorizacion (segundo usuario) espera antes de vencer.
SOLICITUD_VENCE_DIAS=7
# Autorizaciones del personal (FX-THF-AP): valida al guardar que quien actua este
# autorizado para la actividad, el metodo y los equipos. false solo para cargar
# datos iniciales; vuelve a true al terminar.
AUTORIZACIONES_OBLIGATORIAS=true
# Lo que captura una cuenta temporal con supervisor queda pendiente de visto bueno.
SUPERVISAR_CUENTAS_TEMPORALES=true

# Envio del informe desde la plataforma (opcional, Fase 6). Defina TODAS o NINGUNA:
# sin ellas solo esta el envio manual (desde el correo institucional, con evidencia).
# El puerto 465 usa TLS directo. SMTP_HOST=prueba usa un transporte en memoria (pruebas, sin red).
# SMTP_HOST=smtp.cicese.mx
# SMTP_PORT=587
# SMTP_USER=ficotox@cicese.mx
# SMTP_PASS=
# SMTP_FROM="Laboratorio FICOTOX <ficotox@cicese.mx>"

# Base de datos
# SQLite (por defecto): instance/ficotox.sqlite3
# SQLITE_PATH=instance/ficotox.sqlite3
# MySQL/MariaDB:
# DATABASE_URL=mysql://usuario:password@localhost:3306/ficotox

# Cuentas
# Dominios de correo admitidos al dar de alta cuentas (lista separada por comas;
# vacio = cualquier dominio). El acceso es solo con usuario y contrasena del sistema.
ALLOWED_EMAIL_DOMAINS=cicese.mx,ficotox.local

# CORS para /api/*. Vacio = solo el mismo origen (recomendado). Lista separada
# por comas de origenes permitidos, o * para abrirla a cualquiera.
CORS_ORIGINS=

# Servidor (scripts/start-ficotox.mjs)
HOST=0.0.0.0
PORT=5000
FICOTOX_OPEN_BROWSER=true

# Evidencia instrumental de los analisis (Fase 10)
# Tamano maximo por archivo adjunto (MB). Por encima de 25 hay que volver a
# construir (npm run build): el limite del proxy de Next se fija al construir.
EVIDENCIA_MAX_MB=25
# Documentos SGC: tamano maximo por archivo en MB (el limite del proxy se fija al construir: npm run build).
# BIBLIOTECA_MAX_MB, el nombre anterior, se sigue leyendo si este falta.
DOCUMENTOS_MAX_MB=50
# true: "Enviar a revision" exige al menos una evidencia vigente (cromatograma,
# reporte del equipo, hoja de calculo...). No aplica retroactivamente a lo ya aprobado.
EVIDENCIA_OBLIGATORIA_ANALISIS=true

# Fase 11: clave del formato "Registro de no conformidad" que se imprime en el PDF de la NC
# (por confirmar con Mejora Continua). Vacio = "FX-MC-NC (por confirmar)".
NC_FORMATO_CLAVE=

# Respaldos (Fase 10: scripts/respaldar-ficotox.mjs, scripts/restaurar-ficotox.mjs,
# scripts/backup_ficotox.py). Ver CLAUDE.md, "Respaldos y restauracion".
# Numero de respaldos locales que se conservan (nunca se borra el ultimo verificado).
RESPALDO_RETENCION=30
# Aviso "sin respaldo" (npm run verificar-instalacion) si el ultimo tiene mas de estas horas.
RESPALDO_AVISO_HORAS=24
# Aviso "sin prueba de restauracion" (npm run verificar-instalacion) si la ultima aprobada tiene mas de estos dias.
PRUEBA_RESTAURACION_AVISO_DIAS=90
# Carpeta de los respaldos locales (por omision backups/ en la raiz del proyecto).
# FICOTOX_BACKUP_DIR=
# FICOTOX_ONEDRIVE_SYNC_DIR=
# FICOTOX_ONEDRIVE_REMOTE=
# FICOTOX_GRAPH_ENABLED=false

# ---------------------------------------------------------------------------
# Fase 12: produccion (ver CLAUDE.md, "Despliegue")
# `npm run configurar` escribe HOST, PORT, dominios, instancia, JWT_SECRET y
# SECRET_KEY (esta ultima solo si no existe; nunca la cambia).
# Carpeta de la instancia (base, archivos, llave, registros, verificaciones).
# FICOTOX_INSTANCE_DIR=instance
# Migraciones versionadas: el servidor aplica las pendientes al arrancar (con un
# respaldo "pre-migracion" antes). false = no arranca si hay pendientes
# (aplicarlas a mano con npm run migrar).
MIGRAR_AL_ARRANCAR=true
# Solo MySQL/MariaDB: el respaldo previo a migrar se hace con mysqldump fuera de
# la aplicacion; true declara que ya se hizo (si no, no migra al arrancar).
MIGRAR_MYSQL_RESPALDO_HECHO=false
# HTTPS opcional: certificado y llave en PEM (y cadena de la CA si hace falta).
# Sin ellos el servidor usa HTTP (solo red interna). Ver CLAUDE.md, "Despliegue".
# TLS_CERT=instance/tls/ficotox.crt
# TLS_KEY=instance/tls/ficotox.key
# TLS_CA=
# Registros del servidor (sin contrasenas, tokens ni correos completos).
# Por omision <instancia>/logs; se rota a partir de LOG_MAX_MB y se quitan los de
# mas de LOG_RETENCION_DIAS dias.
# LOG_DIR=
LOG_MAX_MB=10
LOG_RETENCION_DIAS=90
